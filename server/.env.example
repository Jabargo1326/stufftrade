# Copy this file to ".env" (same folder) and fill in your MySQL details.
# XAMPP default: user root, EMPTY password.  MySQL Installer: the password you chose.
# (Hosting sites give one address instead: DATABASE_URL=mysql://user:password@host:port/name - then DB_* are ignored)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stufftrade
# Cloud database (TiDB Cloud etc.) needs an encrypted connection. Leave this out when running on your own computer.
# DB_SSL=true

PORT=3001
JWT_SECRET=change-this-to-any-long-random-text

# Add the demo users/posts automatically if the database is empty (handy on a fresh online database)
# SEED_DEMO=true
